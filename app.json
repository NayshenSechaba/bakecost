{
  "expo": {
    "name": "Doughnomic",
    "slug": "doughnomics",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "doughnomic",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#26221F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doughnomic.app"
    },
    "android": {
      "package": "com.doughnomic.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EC"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
